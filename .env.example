# Copy to .env.local for local development.

# Postgres connection string (RDS in production; local Docker container in dev)
DATABASE_URL="postgresql://caringtouchreno:devpassword@localhost:5433/caringtouchreno"

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""

# Used only by prisma/seed.ts to create the first admin login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Absolute base URL — required for PayPal/WiPay redirect callbacks.
NEXT_PUBLIC_SITE_URL="https://caringtouchreno.com"

# --- Added in later phases ---
# S3 + CloudFront (media uploads)
# AWS_REGION=""
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# PayPal Orders v2 — from developer.paypal.com. Checkout hides the PayPal
# option entirely until both of these are set.
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_ENV="sandbox"

# WiPay — sandbox works with no credentials (WiPay's own fixed test
# account_number/api_key). Set these + WIPAY_ENVIRONMENT=live to go live.
WIPAY_COUNTRY_CODE="JM"
WIPAY_CURRENCY="USD"
WIPAY_FEE_STRUCTURE="customer_pay"
# WIPAY_ENVIRONMENT="live"
# WIPAY_ACCOUNT_NUMBER=""
# WIPAY_API_KEY=""

# Mailtrap — requires a Verified sending domain (mailtrap.io -> Sending
# Domains) before real email will send; until configured, transactional and
# campaign emails just log to the console.
# MAILTRAP_API_TOKEN=""
# MAILTRAP_SENDER_EMAIL=""
